--- armed, but the cwd has no board, or the armed file is stale (older than reentry_hours)
allow:here
  rc=0 stderr=0
allow:here
  rc=0 stderr=0
--- a worktree cwd reads its primary
deny:away
  rc=0 stderr=0
--- garbage, empty, an unknown subcommand: no opinion, rc 0
allow:here
  rc=0
denied:not-armed
  rc=0
allow:here
  rc=0
