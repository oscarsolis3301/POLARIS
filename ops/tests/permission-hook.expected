{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"The owner approved the plan and left. Do not ask. Take the recommended option and write it down as an assumed: line; if there is no safe default, park that one piece and finish the rest. This needs a person: park it — bash ops/polaris defer -m \"Bash needed approval\" -- git push --force origin \"main\""}}}
  rc=0 stderr=0
{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"The owner approved the plan and left. Do not ask. Take the recommended option and write it down as an assumed: line; if there is no safe default, park that one piece and finish the rest. This needs a person: park it — bash ops/polaris defer -m \"Edit needed approval\" -- src/app.js"}}}
  rc=0 stderr=0
  rc=0 stderr=0
  json ok: deny
