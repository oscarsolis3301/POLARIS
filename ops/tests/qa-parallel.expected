on-ui: rc=0 overlapped: yes ran: lint typecheck 
  test marker: never
  stamp scope: ui
     depth: ui — only ui paths (1) in 1-2 point work
     ui — test, build and uat skipped: lint and typecheck plus the before/after look
  ✅ lint — green
  ✅ typecheck — green
