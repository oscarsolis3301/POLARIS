#!/usr/bin/env bash
# POLARIS v5 — board CLI. Pure bash + git. No other dependencies.
# Every board mutation goes through this script. Manual fallback: ops/MANUAL.md
# Bash >= 3.2 (macOS default) compatible: no mapfile, no assoc arrays.
set -eu
POLARIS_V=5

OPS_DIR="$(cd "$(dirname "$0")" && pwd)"

# --- FAST PATH: find/show answer before the environment is resolved ------------------
# `find` is the hot lookup an agent runs ten times a task, and it reads NONE of the globals below.
# Traced 2026-07-25 (Windows/Git Bash): of a 3.6s `find`, 1.9s went to git-common-dir (0.47s), three
# cfg reads (1.0s) and hostname (0.07s) — all for a command that needs one path and one engine.
# So find/show run here, one git call deep, and exit. Everything below this block is skipped.
# If lib/search.sh is missing we fall THROUGH deliberately: the loader prints the proper
# incomplete-kit remedy, which is a better error than anything this block could invent.
case "${1:-}" in
  find|show)
    if [ -f "$OPS_DIR/lib/search.sh" ]; then . "$OPS_DIR/lib/search.sh"; index_fast "$@"; fi ;;
esac

# `help` needs the text below and NOTHING else — no modules, no git, no CONVENTIONS. It used to
# source all 15 lib modules and resolve the full environment to print a heredoc: 2820ms measured.
# usage() lives up here so both the fast path and the dispatch table below can reach it.
usage() { cat <<'EOF'
polaris — POLARIS board CLI (run from anywhere inside the repo)
  init-board                     create board dirs, gitignore .polaris/ + the board set, lock dir
                                 (board state commits to refs/heads/polaris/board — base stays clean)
  pack [ID]                      YOUR WHOLE CONTEXT FOR ONE TASK, IN ONE CALL — run this FIRST,
                                 before reading anything: the task's Why + acceptance, its contract
                                 verbatim, the repo's DETECTED house style, files you own vs may
                                 only read, the code-map for each owned directory, the public API
                                 surface you must not break, the known traps recorded against those
                                 exact paths, and the verify: commands that will be run. Read-only.
                                 No ID inside a feat/<ID> worktree = that task. Replaces the 6-15
                                 exploratory round trips a cold session otherwise spends
  claim [ID]                     lock + ready→active + worktree  (no ID = top wsjf; skips locked)
  resume [ID]                    re-enter an already-claimed active task (crash/kickback/new session)
  verify [ID]                    diff ⊆ files_owned + run verify: commands (in worktree)
  handoff [ID]                   verify + push + active→review   (lock stays)
  release <ID> [--to ready|blocked] [-m note]   abort: give the task back cleanly
  park [-m why]                  stash the primary's dirty tree (tracked + untracked) as
                                 polaris/park-<epoch> — a dirty shared checkout is parked, never
                                 asked about; reversible in ONE command
  unpark                         restore the newest polaris/park-* stash (says what came back)
  grant <ID> <path> -m "why"     append one path to a CLAIMED task's files_owned (sanctioned
                                 amendment; REFUSES any overlap with another ready/active task's
                                 ownership — refusal mutates nothing; RULES.tsv still binds)
  amend <ID> --verify <n> -m "why" -- <cmd…>
        | --verify <n> --drop -m "why" | --verify --add -m "why" -- <cmd…>
                                 replace, drop or append ONE verify: line of a CLAIMED task (the
                                 sibling of grant: grant widens ownership, amend corrects the
                                 acceptance list). REFUSES on any feat/* branch — a Builder never
                                 rewrites its own gate — and refuses a bare full-suite command;
                                 refusal mutates nothing; the why lands on the task's record
  approve <ID> <scope> -m "why"  record a HUMAN's yes to an `ask` rule on one task's approved:
                                 list (the sibling of grant: grant widens ownership, approve
                                 clears a policy gate — and only approve needs a human. REFUSES
                                 when no ask rule gates <scope> and on any feat/* branch, so a
                                 Builder can never approve itself; refusal mutates nothing)
  kickback <ID> [-m note]        Integrator: red merge → review→active
  audit <ID>                     Integrator: ownership check of feat/<ID>
  run-verify <ID>                Integrator: re-run task verify: commands in CWD
  done <ID>                      Integrator: review→done + map_delta as docs(map): on base + cleanup
  task-commit-msg <task-file>    print the task's landed-commit message (pure; `land` consumes it)
  land <ID>                      Integrator, on integrate/<date>: audit + squash feat/<ID> into
                                 ONE rich commit ([<ID>] subject + Landed-from trailer; no board write)
  land --express <ID>            ONE pass for a single small task, from <base>: integrate branch +
                                 audit/land + ONE full suite (red → unwind + kickback) + seal +
                                 run-verify + done + branch cleanup. Refuses: another task in
                                 review/ · risk: high · express: off · publish: pr. Every gate of
                                 the long path still runs; `finish` stays the finish line.
  seal [<date>]                  Integrator: seal the wave — merge integrate/<date> into base
                                 (--no-ff, per-task bullets) + lightweight tag sprint/<n>; a later
                                 wave's seal MOVES the tag (sprint's latest sealed checkpoint).
                                 publish: pr (CONVENTIONS key, default direct): NO local merge —
                                 pushes ONLY integrate/<date> + prints the PR-create URL
  seal --sync [<date>]           publish: pr only — finish the wave after the human merges the PR
                                 (MERGE COMMIT strategy, never squash): verify every [<ID>] subject
                                 reached base, tag sprint/<n>, delete integrate/<date> local+remote
  report [--sprint <n> | --all]  render the management-readable per-sprint record (docs/sprints/
                                 by default) from the board + history; writes the file(s), prints
                                 the path(s), commits nothing (seal commits it on the wave instead)
  learned -m "<bullet>"          append ONE lesson to ops/SPRINT.md § Learned (any lane, any branch;
                                 board commit) — the Planner reads it first, EVOLVE prunes it to ≤5
  history [--tasks <n>]          changelog view of base (board noise hidden); --tasks <n> drills
                                 into one sealed sprint's task commits, across all its waves
  rollback <ID|sprint/<n>>       revert one landed task (or the sprint's latest sealed wave, -m 1)
                                 on base — forward-only: never resets, never force-pushes
  status [--brief] | sweep [--fix] | doctor [--selftest [--only <patterns>] [--parallel <N>] | --fast]
                                 status --brief = ONE plain-English paragraph, no table (plain status
                                 unchanged): Last landed: / Next up: markers + a sprint-column clause
                                 doctor --selftest --only <patterns> = the always-on spine + only the
                                 labeled drills matching any comma-separated glob (fmlist tcm report
                                 metrics brain rules drift hardening qa finish claudemd remote syncrace
                                 notify grant upgrade pr-publish express hint brief); a nonsense element dies
                                 before the spine (unknown drill label); --parallel <N> = run the
                                 selected drills as N parallel child shards (serial stays the default)
                                 doctor --fast = the in-process tier: pure functions, no CLI re-invocation, no scratch repo — seconds
  check [--only <glob>] [--update]
                                 golden-output acceptance tests, ZERO LLM: ops/tests/<name>.cmd is
                                 run and its stdout diffed against <name>.expected (optional
                                 <name>.rc = expected exit code). --update rewrites goldens — a
                                 human/Builder decision, never automatic. Wire it into qa by setting
                                 `uat: bash ops/polaris check` in ops/CONVENTIONS.md
  check --scaffold [--app] [--cmd "<shell>"]
                                 GENERATE the pairs from observed behavior — public API surface per
                                 source dir (from the index) + this CLI's parsed output shapes. Runs
                                 each candidate TWICE and discards any that flaps, is empty, or whose
                                 command is missing. Never overwrites an existing golden. --cmd adds
                                 ONE behavioural golden for your own command (auto-running an app's
                                 executables would start servers, so it is opt-in). --app locks the
                                 HOST app's shape instead: declared dependencies (Invariant 8 as a
                                 diff), npm script names, HTTP routes, migration set, and referenced
                                 env var NAMES — all by reading tracked files, never by running the
                                 app. REVIEW the output: a golden records what the code DOES, not
                                 what it SHOULD do.
  harness [--refresh]            GENERATE ONE runnable test suite for the HOST APP — the behaviour
                                 tier above `check --scaffold --app` (which only locks shape by
                                 reading files, and so cannot tell you the app still BOOTS).
                                 Detects the stack, writes <tests>/test_polaris_harness.py or
                                 polaris-harness.test.js, and captures a baseline inventory.
                                 Three sweeps: every module IMPORTS · every GET route answers
                                 non-5xx · every declared entry point runs --help without crashing;
                                 plus "nothing disappeared" against the baseline. A sweep that
                                 cannot find what it needs SKIPS and says why — it never passes by
                                 asserting nothing, and it never invents an app factory's args.
                                 Written once by an agent, then costs a subprocess and ZERO tokens
                                 forever. Wire into `uat:` so qa picks it up. --refresh regenerates
                                 the file and re-captures the baseline (how you accept a real change)
  find <symbol> | -f <glob> | -t <text> | --importers <path> | --imports <path> | --api <glob> [-n N]
                                 the 1-hop "where is X": ONE line per hit, path:line first, ranked
                                 (exact > prefix > substring, boosted by churn + fan-in, tests and
                                 vendor down-weighted). Backed by a generated .polaris/index.db;
                                 self-heals on query. No python3 → says so and you fall back to Grep
  show <path>#<symbol> | <path>:<line>
                                 print JUST that symbol's body — not the whole file
  board-fm [<col>…]              one TAB line per task (col id pts wsjf risk deps owns contract
                                 title) — the Planner's board read without the prose bodies.
                                 Default columns: ready active backlog blocked (done/ is history,
                                 pass it explicitly). Non-task files (IDEAS.md) are skipped
  brain [--refresh]              generate .polaris/brain/ — gitignored knowledge base a cold agent
                                 reads FIRST (INDEX + code-map/board/contracts/commands/gotchas);
                                 --refresh skips code-map when code is unchanged. seal auto-refreshes
                                 an existing brain; doctor warns when it is stale
  metrics                        opens with a plain-English summary line, then cycle · throughput ·
                                 kickbacks · build-vs-integrate split (EVENTS.ndjson)
  why <ID>                       why a task bounced/blocked: kickback + release/blocked notes from telemetry + body
  notify-gate <kind> [ID]        fire the notify: hook at a human gate, and nothing else — kinds:
                                 plan · risk <ID> · question <ID> · done [ID]  (observe-only:
                                 never writes the board, EVENTS.ndjson, or any lock)
  triage                         which LANE this board's work belongs in — line 1 is one word:
                                 solo (one context, zero subagents; 1 task ≤3pts — or up to 4
                                 tasks, ≤3pts each and ≤6pts in all, worked one at a time — risk
                                 normal, express on, publish direct) · express (one task, one
                                 builder, one integrator) · full (everything else). Reasons follow
                                 on note lines. Decide with this, never by re-reading the board
                                 and weighing the conditions by hand.
  route [<ID> | --role <R> | --points <N> [--risk <R>]]
                                 which MODEL TIER runs a piece of work — line 1 is always one
                                 word: strong | mid | cheap (a task's model: frontmatter
                                 overrides; unknown role → mid, routing never blocks work). A
                                 `   model: <name>` note follows ONLY when ops/CONVENTIONS.md
                                 maps that tier (model_strong/mid/cheap). Read-only: the
                                 CONDUCTOR asks it before every spawn; fleet rides the max
                                 tier over ready/
  next [--do|--brief]            what this session does NEXT, read off the board — line 1 is ONE verb:
                                 resume <ID> · build <ID> · integrate · promote · wait · stop · finish;
                                 --do performs a promote under the board lock · --brief re-anchors a chat
  promote                        = next --do: promote every backlog/ task that now clears the ready
                                 gate, ONE board commit, then the fresh route (line 1 is still a verb)
  drift [--strict]               mechanical board-hygiene audit (overlap · ready gate · cruft · stale refs)
  rules                          list + health-check ops/RULES.tsv (repo policy as data)
  surfaces [--scaffold [--apply]]
                                 list + health-check ops/SURFACES.tsv (which tests cover which
                                 source paths, as data): refuses a row whose tests glob covers its
                                 own surface, flags a glob matching 0 or >200 tracked files. Rows
                                 are written ONLY by `done` from a task's surface: list, or by
                                 --scaffold --apply — never by hand (RULES-guarded); drift carries
                                 the ⛔ findings. --scaffold PROPOSES rows from the stack's own
                                 layout (pytest · jest · vitest · go): only pairings the layout
                                 makes unambiguous, over-selecting in doubt, the ambiguous ones
                                 listed as skipped; writes nothing. --apply writes those rows
                                 (tagged [scaffold]) and sets test_select: when it is unset — on
                                 <base> only; nothing is committed for you
  qa [--force] [--full]          is everything okay, in ONE shot: test/lint/typecheck/build/uat
                                 from CONVENTIONS + drift --strict + doctor env check. Runs every
                                 check even after a red; rc 1 if anything was red.
                                 SKIPS the suite when HEAD is unchanged since the last green run
                                 and the tree is clean (.polaris/suite-stamp) — drift and doctor
                                 still run every time. --force always re-runs the suite.
                                 With test_select: set, test: runs ONLY the SURFACES.tsv commands
                                 the changed paths map to (every changed path needs a row, else
                                 the whole suite runs); the stamp records full|scoped.
                                 --full runs test: verbatim. `finish` runs this for you at the close.
  bg run <name> [--force] [-- <cmd…>]
                                 detach a suite past the harness's 600s tool cap and keep working:
                                 a bare CONVENTIONS suite key (test test_fast lint typecheck build
                                 uat — runs in the CALLER's cwd; qa — always the PRIMARY, so its
                                 green stamps .polaris/suite-stamp and `finish` rides the existing
                                 fast path) or an arbitrary command after --. Registry (runtime
                                 state, never tracked): .polaris/bg/<name>/ under the primary; a
                                 finished same-name job rotates to <name>.prev — archived, never
                                 deleted. Never writes the board, EVENTS.ndjson, or any lock
  bg status [<name>] | bg tail <name> [-n N] | bg wait <name> [--max <s>]
                                 collect it in bounded chunks: status is rc-file-FIRST (0 green ·
                                 1 red · 2 running · 3 unknown: dead pid + no rc — crashed, or
                                 Windows reused the pid); tail = last N (default 20) log lines;
                                 wait polls ~2s up to --max (default 300 — half the cap), prints
                                 the tail + verdict and exits 0/1, or ONE resumable `still
                                 running` line + rc 2 — chunk-resumable, NEVER a question
  finish [--force]               is the RUN over? The LAST command of every lane. Nothing building,
                                 nothing waiting to land, ready/ drained per drain:, no unmerged
                                 integrate/<date>, no orphan lock, clean tree on base, qa green.
                                 rc 0 = complete (the notify: done hook fires, exactly once per
                                 finished state) and the agent may open its reply with the
                                 `# 🎉 Complete!` H1; rc 1 names every pending thing, and there is
                                 no H1. `caveat:` lines are not gates — the close must mention them.
  dash [--port N]                live read-only board at http://127.0.0.1:7373 (needs python3)
  fleet <N> [--loop] [--launch] [--dry-run]
                                 print N Builder kickoffs; --launch opens a session per task in
                                 tmux windows or Windows Terminal panes (--dry-run previews the command)
  upgrade                        migrate an OLD BOARD (v3/v4→v5). Idempotent. Downloads NOTHING.
                                   want a newer KIT? that is `update` — one letter, unrelated job.
  adopt                          append a COMMENTED stub to ops/CONVENTIONS.md for every key this
                                 repo has never set — each carries the key's default and what it
                                 unlocks (from ops/KEYS.tsv). Uncomment a line to enable that
                                 feature; adopt itself never edits a value, never uncomments, and
                                 never changes behavior. Idempotent — a second run appends nothing
  heal                           repair the configuration token efficiency depends on: comment out
                                 any FORBIDDEN model_* value (Fable/Haiku are refused in kit code
                                 regardless) and append the marked efficiency section to this repo's
                                 own CLAUDE.md, once. install and update run it for you, so every
                                 machine self-repairs. Append-only, marker-guarded, idempotent — it
                                 never edits your prose, never deletes, never rewrites a human choice
  interview [--pending | --set <key>=<value> …]
                                 the preferences a repo cannot derive — how to be talked to
                                 (voice), ADHD-shaped replies (adhd), one computer or several
                                 (claim) — generated from ops/KEYS.tsv's ask column. Plain =
                                 print what is still unanswered as QUESTION/OPTION lines (ask
                                 them in ONE round); --set writes the answers into
                                 ops/CONVENTIONS.md (a stub is replaced in place) and applies
                                 them (adhd: on lets /i-have-adhd fire on its own); --pending =
                                 rc 1 + one line when anything is unanswered. Never runs from
                                 update --auto
  slim [--apply | --restore]     the per-context TOKEN TAX, measured: every skill/agent/command
                                 definition under ~/.claude injects its name+description into the
                                 system prompt of every session AND every subagent it spawns,
                                 invoked or not. Reports bytes per family, marks the ones no
                                 POLARIS role/CLAUDE.md/PROTOCOL.md ever names, and totals what a
                                 6-8 context run pays for them. --apply MOVES those into
                                 ~/.claude/.polaris-archived/ (never deletes); --restore puts them
                                 all back. Report-only by default; the installer never applies it
  skill list | gaps | budget | propose <glob> [--name N] [--write] [--force]
        | promote <name> | demote <name> | prune [--apply] | restore <name>
                                 skills POLARIS writes for itself (ops/contracts/self-skills.md):
                                 list = name · tier · bytes · hits/W · last hit · paths; gaps = the
                                 surfaces the board keeps returning to with no skill; budget = the
                                 shelf constants + Σ tier-1 frontmatter bytes (rc 1 when over);
                                 propose = a deterministic SKELETON on stdout — --write creates
                                 .claude/skills/N/SKILL.md born HIDDEN (disable-model-invocation:
                                 true = 0 prompt bytes) on <base> only, never overwrites, refuses
                                 reserved names; promote flips it visible (refuses a TODO( trigger,
                                 >320 B, a shelf past 1600 B) — EVOLVE proposes it, a human runs it;
                                 demote is the free reverse; prune = eviction verdicts over
                                 EVENTS.ndjson, --apply archives under .polaris/skills-archived/
                                 (never deletes); restore brings one back from the archive or git
  awake [status|start|stop]      ONE keep-awake daemon per machine (~/.claude/polaris/awake): presses
                                 F15 every ~55s while any session is busy; exits by itself once every
                                 session and repo is idle. start = arm now · stop = 60 min off
  version                        installed version · commit · latest on the channel
  update [--auto|--all [--major]] [--repo-only]
                                 fetch the latest KIT from the channel. Plain = explicit, as always.
                                 --auto = the session-start path: self-updates when the board is
                                 quiet (auto_update: off stops it), silent unless it acted; a MAJOR
                                 version only ever asks. --all = walk the machine registry: every
                                 quiescent installed repo updates — runs THIS kit's updater in each,
                                 so a 5.x install is reached too; --major applies MAJOR bumps as
                                 well. Also re-caches the kit into ~/.claude so the NEXT repo you
                                 install into gets it too; --repo-only skips that.
  uninstall --yes                remove POLARIS from this repo (keeps your CLAUDE.md + hooks)
EOF
}

case "${1:-}" in
  ''|help|-h|--help) usage; exit 0 ;;
esac

# --- lib loader: every function body lives in lib/ — fixed order, core first ---
# The write-guard calls _match/_rules on EVERY edit and needs only core+ownership (22KB of 249KB).
# Sourcing all 14 there cost ~2s/call — twice per write against a 10s hook timeout, which under
# parallel builders EXCEEDED it and made the guard fail OPEN. Load what the command needs.
# (ops/contracts/module-layout.md v2 — both lists stay LITERAL, never a glob.)
case "${1:-}" in
  _match|_rules|_guard) _mods="core ownership" ;;
  *)             _mods="core ownership workspace surfaces visual builder integrate knowledge search observe admin bg awake handover skills
                        selftest/spine selftest/board selftest/history selftest/report
                        selftest/brain selftest/policy selftest/remote selftest/fast" ;;
esac
for _m in $_mods; do
  if [ ! -f "$OPS_DIR/lib/$_m.sh" ]; then
    printf '⛔ POLARIS: ops/lib/%s.sh is missing — this kit is incomplete. Re-run the installer (bash ops/install.sh) or fetch a fresh kit: ops/polaris update\n' "$_m" >&2
    exit 1
  fi
  . "$OPS_DIR/lib/$_m.sh"
done
unset _m _mods

# ---------------------------------------------------------------- resolve env
# Traced 2026-07-25 (Windows/Git Bash): this block cost ~2.2s on EVERY invocation — `cfg base` 683ms,
# `hostname` 524ms, a redundant `rev-parse --git-dir` 171ms, and `SELF` 132ms in three subshells —
# before any command did a single unit of work. Roles run ~20 CLI calls a session and the write-guard
# runs one per edit, so it was the largest fixed tax in the kit. Four fixes, no behaviour change:
#   1. ONE git call, not two. `--git-common-dir` already fails outside a repo, so the separate
#      `rev-parse --git-dir` probe proved something the next line learns anyway.
#   2. ONE awk for base/claim/stale_hours (cfg_boot) instead of three cfg calls.
#   3. SELF from OPS_DIR, which line 8 already resolved — `cd`+`dirname`+`basename` was 3 forks.
#   4. WHO is now lazy (core.sh::who) — only the mutation paths ever read it.
# Deliberately NOT cached to disk: the two remaining git calls total ~220ms, and a stale PRIMARY
# would write the board into the wrong checkout. Cheap and correct beats fast and occasionally wrong.
_gcd="$(git rev-parse --git-common-dir 2>/dev/null)" || die "not inside a git repo"
[ -n "$_gcd" ] || die "not inside a git repo"
GCD="$(cd "$_gcd" && pwd)"; unset _gcd                     # shared across all worktrees
PRIMARY="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
[ -n "$PRIMARY" ] || die "cannot resolve primary checkout"
OPS="$PRIMARY/ops"
BOARD="$OPS/board"
LOCKS="$GCD/polaris-locks"
CONV="$OPS/CONVENTIONS.md"
VER="$OPS/VERSION"
SELF="$OPS_DIR/${0##*/}"
eval "$(cfg_boot)"                                         # BASE + CLAIM_MODE + STALE_H, one fork
WHO=""                                                     # filled on demand by who(); see core.sh
EVENTS="$BOARD/EVENTS.ndjson"

RULES="$OPS/RULES.tsv"
SURFACES="$OPS/SURFACES.tsv"
MUTEX="$LOCKS/.board-mutex"
FAIL_LOCK_ID=""
PUB="direct"
PUBLISH_WARNED=""
BOARD_REF="refs/heads/polaris/board"

# --- worktree liveness beat (ops/contracts/worktree-liveness.md v1.1) ---------
# Every CLI call made from inside a task worktree says "someone is in here", so done/release/sweep
# never reap a worktree a session is still working in. Builtins only — string ops and one `: >`, zero
# forks — and BELOW the EVENTS= line so `startup-budget`'s cfg-fork count over the resolve-env block
# is untouched. `2>/dev/null` comes BEFORE the `>`: redirections apply left to right, so the v1 order
# opened the file while stderr was still the terminal and printed "No such file or directory" on
# every call from a worktree whose git worktrees dir does not exist yet. Best-effort, never fatal.
case "$PWD" in */.polaris/wt/*) _w="${PWD##*/.polaris/wt/}"; _w="${_w%%/*}"; : 2>/dev/null > "$GCD/worktrees/$_w/polaris-beat" || true;; esac

# ------------------------------------------------------------------- dispatch
# update_check_maybe is wired ONLY into the human-facing commands below — deliberately not
# into _match/_rules, which the write-guard fires on every single edit.
case "${1:-}" in
  init-board) cmd_init_board;;
  claim)      shift; awake_ensure || true; update_check_maybe || true; cmd_claim "$@";;
  pack)       shift 2>/dev/null || true; cmd_pack "${1:-}";;
  resume)     shift; cmd_resume "$@";;
  verify)     shift; cmd_verify "$@";;
  handoff)    shift; awake_ensure || true; cmd_handoff "$@";;
  release)    shift; cmd_release "$@";;
  park)       shift; cmd_park "$@";;
  unpark)     shift; cmd_unpark "$@";;
  grant)      shift; cmd_grant "$@";;
  amend)      shift; cmd_amend "$@";;
  approve)    shift; cmd_approve "$@";;
  kickback)   shift; cmd_kickback "$@";;
  audit)      shift; cmd_audit "$@";;
  run-verify) shift; cmd_run_verify "$@";;
  done)       shift; cmd_done "$@";;
  task-commit-msg) shift; cmd_task_commit_msg "$@";;
  land)       shift; cmd_land "$@";;
  seal)       shift; cmd_seal "$@";;
  history)    shift; cmd_history "$@";;
  report)     shift; cmd_report "$@";;
  learned)    shift; cmd_learned "$@";;
  rollback)   shift; cmd_rollback "$@";;
  status)     shift 2>/dev/null || true; awake_ensure || true; update_check_maybe || true; cmd_status "${1:-}";;
  brain)      shift 2>/dev/null || true; cmd_brain "${1:-}";;   # no update_check_maybe: agents run it cold and often — keep it quiet + pure
  # find/show are handled by the FAST PATH at the top of this file and never reach here — they
  # exit before the globals below them exist. They stay in `usage` above because that is what
  # documents them; ops/tests/cli-help-parity.cmd asserts they are still listed.
  check)      shift 2>/dev/null || true; cmd_check "$@";;
  harness)    shift 2>/dev/null || true; cmd_harness "${1:-}";;
  board-fm)   shift 2>/dev/null || true; cmd_board_fm "$@";;
  sweep)      shift 2>/dev/null || true; cmd_sweep "${1:-}";;
  doctor)     shift 2>/dev/null || true; awake_ensure || true; update_check_maybe || true; cmd_doctor "$@";;
  metrics)    cmd_metrics;;
  why)        shift; cmd_why "$@";;
  triage)     cmd_triage;;
  route)      shift; cmd_route "$@";;   # no update_check_maybe: read-only oracle, called before EVERY spawn — keep it quiet + pure
  drift)      shift 2>/dev/null || true; cmd_drift "${1:-}";;
  rules)      cmd_rules;;
